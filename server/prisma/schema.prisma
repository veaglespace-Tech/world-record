generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  password             String
  referralCode         String    @unique
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
}

model User {
  id            Int      @id @default(autoincrement())
  fullName      String
  email         String
  phone         String
  address       String?
  dob           String?
  gender        String?
  bloodGroup    String?
  aadharNo      String?
  aadharImage   String?
  passportPhoto String?
  
  referredBy    String
  
  PathakId       Int?
  Pathak         Pathak?   @relation(fields: [PathakId], references: [id])
  
  createdAt     DateTime @default(now())
}

model Pathak {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  adminName   String?
  adminEmail  String?
  address     String?  @db.Text
  logoUrl     String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
